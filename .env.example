# Copy only the DEV block to .env.development.local (never commit that file).
VITE_APP_ENV=DEV
VITE_DEV_SUPABASE_URL=http://127.0.0.1:54321
VITE_DEV_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_replace_me

# STAGING build requires SELAH_STAGING_BUILD=LOCAL_STAGING_BUILD in the process.
# Do not publish or connect a hosted environment without specific approval.
# PROD remains disabled even with valid configuration.
# .env.staging.local: VITE_APP_ENV=STAGING
# VITE_STAGING_SUPABASE_URL=
# VITE_STAGING_SUPABASE_PROJECT_REF=
# VITE_STAGING_SUPABASE_PUBLISHABLE_KEY=
# VITE_STAGING_SITE_ORIGIN=https://staging.example.invalid
# VITE_STAGING_ADDITIONAL_SITE_ORIGIN=https://second-domain.example.invalid
# .env.production.local: VITE_APP_ENV=PROD
# VITE_PROD_SUPABASE_URL=
# VITE_PROD_SUPABASE_PROJECT_REF=
# VITE_PROD_SUPABASE_PUBLISHABLE_KEY=
# VITE_PROD_SITE_ORIGIN=https://beta.example.invalid
